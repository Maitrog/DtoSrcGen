<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>9</LangVersion>
        <RootNamespace>DtoSrcGen</RootNamespace>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageId>Maitrog.DtoSrcGen.Attributes</PackageId>
        <Version>1.0.0</Version>
        <Authors>Maitrog</Authors>
        <Description>Attributes for Maitrog.DtoSrcGen: TypeScript-style utility types (Pick, Omit, Partial, Readonly, Required, Record, Union) for shaping DTOs.</Description>
        <PackageTags>dto;source-generator;roslyn;codegen;utility-types;typescript</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Maitrog/DtoSrcGen</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
